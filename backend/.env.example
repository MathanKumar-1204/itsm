# Backend Environment Variables
FLASK_ENV=development
FLASK_DEBUG=false
PORT=5000

FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Cloud Atlas Primary Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=itsm_platform

# JWT Secret for Session & Enterprise Auth
JWT_SECRET=your-jwt-secret-key-change-in-production

# Groq Configuration (GPT-OSS Models with Multi-Key Failover Pool)
GROQ_API_KEY=gsk_your_primary_groq_api_key_here
GROQ_API_KEY_FALLBACK_1=gsk_your_second_fallback_groq_key_here
GROQ_API_KEY_FALLBACK_2=gsk_your_third_fallback_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Pinecone Vector Database
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=itsm-knowledge
PINECONE_NAMESPACE=itsm-public

# Embedding Model (384-dimensional)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ServiceNow REST API Configuration
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your-servicenow-username
SERVICENOW_PASSWORD=your-servicenow-password
SERVICENOW_CLIENT_ID=your-servicenow-client-id
SERVICENOW_CLIENT_SECRET=your-servicenow-client-secret
SERVICENOW_AUTH_MODE=basic
SERVICENOW_DEMO_MODE=false



# File Upload Limit in MB
MAX_UPLOAD_MB=10
